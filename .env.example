PORT=4002
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/doctorekhane
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
FRONTEND_URL=https://doctorekhane.com
ADMIN_URL=https://admin.doctorekhane.com
SYSTEM_DOMAIN=https://doctorekhane.com
SYSTEM_EMAIL=support@doctorekhane.com

# Official SMTP credentials. Hospital creation succeeds even if an optional
# notification fails; configure these on the VPS, never in Git.
EMAIL_HOST=smtp.example-provider.com
EMAIL_PORT=587
EMAIL_USER=support@doctorekhane.com
EMAIL_PASS=replace-with-provider-app-password
EMAIL_FROM=Doctor Ekhane <support@doctorekhane.com>
HOSPITAL_NOTIFICATION_EMAIL=support@doctorekhane.com
